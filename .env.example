# Public Convex URLs from the SAME deployment (production for Cloudflare).
# Set both in Cloudflare's build variables AND runtime variables.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Convex CLI development selection only; do not set in Cloudflare.
# CONVEX_DEPLOYMENT=dev:your-development-deployment

# Auth, messaging, webhook and AI secrets belong in Convex, not this file.
# See docs/cloudflare-deployment.md.
